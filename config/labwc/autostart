# labwc autostart for the LXQt session (labwc-plasma-session). Runs once per login, inside labwc.
# Apps started here aren't closed by `lxqt-leave --logout`.

# Wallpaper: ~/.config/labwc/wallpaper (any image, or a link to one) if you made it, else the current
# plasma-themer wallpaper, else a plain color. LXQt's desktop (pcmanfm-qt) is turned off by the installer.
wp=$HOME/.config/labwc/wallpaper
[ -e "$wp" ] || wp=$HOME/.local/share/plasma-themer/current/wallpaper
if [ -e "$wp" ]; then swaybg -m fill -i "$wp" >/dev/null 2>&1 &
else swaybg -c '#0b0b10' >/dev/null 2>&1 &
fi

# Faster startup for GTK apps
dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP >/dev/null 2>&1 &

# Screen off after 3 min idle, but not while a video/music is playing (idle-screen-off waits); any input wakes it
swayidle -w timeout 180 "$HOME/.local/bin/idle-screen-off off" resume "$HOME/.local/bin/idle-screen-off on" >/dev/null 2>&1 &

# Centered OSD for volume/brightness keys (fnkey), charger plug/unplug and power profile changes (power-osd)
swayosd-server >/dev/null 2>&1 &
~/.local/bin/power-osd >/dev/null 2>&1 &

# 3-finger swipe = switch desktop, 3-finger pinch = live zoom (needs the input group)
~/.local/bin/touchpad-gestures >/dev/null 2>&1 &

# Wi-Fi, battery, Bluetooth and volume tray icons with Plasma-style popups (quickpanel), resident so they open instantly.
# Wait (max 15 s) for lxqt-panel's tray first: Qt's QSystemTrayIcon icons never register if they start before it.
(for _ in $(seq 30); do busctl --user status org.kde.StatusNotifierWatcher >/dev/null 2>&1 && break; sleep 0.5; done
 exec ~/.local/bin/quickpanel --daemon) >/dev/null 2>&1 &

# Monitor layout: arrange in wdisplays, then run "Save Monitor Layout" (save-monitor-layout) -> ~/.config/kanshi/config
kanshi >/dev/null 2>&1 &
