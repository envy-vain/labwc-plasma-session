@@ -125,10 +126,33 @@
 	assert(server.input_mode == LAB_INPUT_STATE_CYCLE);
 
 	struct cycle_osd_item *item = node_cycle_osd_item_from_node(node);
+
+	if (item->close_button && item->close_button->node.enabled) {
+		int lx, ly;
+		wlr_scene_node_coords(&item->close_button->node, &lx, &ly);
+		double cx = server.seat.cursor->x;
+		double cy = server.seat.cursor->y;
+		int size = item->close_button_size;
+		if (cx >= lx && cx < lx + size && cy >= ly && cy < ly + size) {
+			/* Window switcher is refreshed once the view is destroyed */
+			view_close(item->view);
+			return;
+		}
+	}
+
 	server.cycle.selected_view = item->view;
 	cycle_finish(/*switch_focus*/ true);
 }
 
+void
+cycle_close_selected(void)
+{
+	assert(server.input_mode == LAB_INPUT_STATE_CYCLE);
+	if (server.cycle.selected_view) {
+		view_close(server.cycle.selected_view);
+	}
+}
